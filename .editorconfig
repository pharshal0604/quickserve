# EditorConfig — https://editorconfig.org
# Ensures consistent formatting across editors and IDEs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.dart]
indent_size = 2
max_line_length = 100

[*.{yaml,yml}]
indent_size = 2

[*.{json,js,ts}]
indent_size = 2

[*.{kt,kts}]
indent_size = 4

[*.{java,gradle}]
indent_size = 4

[*.{xml,html}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf