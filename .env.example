# QuickServe Environment Configuration (Reference Template)
#
# ============================================================================
# IMPORTANT: Flutter does NOT natively read `.env` files.
# This file is a reference template listing the environment variables and
# Dart defines the QuickServe apps expect.
#
# To pass values to Flutter at runtime, use:
#
#   flutter run --dart-define=KEY=value
#
# Or, on Windows cmd.exe, before launching the app:
#
#   set KEY=value
#
# NEVER commit a real `.env` file. Only `.env.example` is committed.
# See docs/Environment_Configuration.md for the full guide.
# ============================================================================


# ---------------------------------------------------------------------------
# Firebase Emulator Mode
# ---------------------------------------------------------------------------

# Set to `true` to connect the Flutter apps to the Firebase Emulator Suite.
# Set to `false` (or omit) to connect to the configured Firebase project.
FIREBASE_USE_EMULATORS=true

# Host used to reach the emulators.
#
#   iOS Simulator / Flutter Web : 127.0.0.1
#   Android emulator            : 10.0.2.2  (host machine address from inside the emulator)
FIREBASE_EMULATOR_HOST=127.0.0.1


# ---------------------------------------------------------------------------
# Emulator Ports (must match firebase.json)
# ---------------------------------------------------------------------------

FIREBASE_AUTH_EMULATOR_PORT=9099
FIREBASE_FIRESTORE_EMULATOR_PORT=8080


# ---------------------------------------------------------------------------
# Crashlytics / Monitoring
# ---------------------------------------------------------------------------

# Enable Crashlytics in local builds. Default is `false` in debug mode.
ENABLE_CRASHLYTICS=false


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Minimum log level for the shared logging layer.
# Allowed values: debug | info | warn | error
LOG_LEVEL=debug


# ---------------------------------------------------------------------------
# Firebase Project Configuration (for reference only — not for `.env`)
# ---------------------------------------------------------------------------
#
# Firebase project config for the Flutter apps lives in:
#
#   apps/mobile/lib/firebase_options.dart
#   apps/admin/lib/firebase_options.dart
#
# Those files are generated by the FlutterFire CLI and are NOT secrets.
# They can be safely committed. Do not duplicate them here.
#
# If you ever need to override them for a specific environment, use
# --dart-define flags at build time, not a committed file.
#
# Example (commented out — do not uncomment with real values):
#
# FIREBASE_PROJECT_ID=quickserve
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_APP_ID=
