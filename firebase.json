{
    "firestore": {
        "rules": "firebase/firestore/rules/firestore.rules",
        "indexes": "firebase/firestore/indexes/firestore.indexes.json"
    },
    "hosting": {
        "public": "apps/admin/build/web",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}
